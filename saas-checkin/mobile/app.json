{
  "expo": {
    "name": "CheckIn RFID",
    "slug": "saas-checkin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "checkin",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.saascheckin",
      "infoPlist": {
        "NFCReaderUsageDescription": "Usado para ler cartões RFID/NFC de clientes.",
        "NSFaceIDUsageDescription": "Usado para autenticação biométrica.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "package": "com.yourcompany.saascheckin",
      "permissions": [
        "android.permission.NFC",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1e40af"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
